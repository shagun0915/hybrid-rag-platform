# Copy to .env and fill in. NEVER commit real values.
# Every variable has a default in app/core/config.py — this file lists
# the ones you're most likely to set. See the README "Configuration
# reference" table for the full list.

ENVIRONMENT=development

# --- Database ---
# Local dev (docker compose) uses this automatically. For a deployment,
# set this to your managed Postgres (e.g. Supabase) connection string.
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@db:5432/rag_platform

# --- LLM provider: ollama (local/free) | groq (cloud/free) | anthropic (cloud/paid) ---
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b

# Groq (LLM_PROVIDER=groq) — free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (LLM_PROVIDER=anthropic) — requires billing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Retrieval / chunking (see README for what to change on a small host) ---
EMBEDDING_DIMENSION=384
CHUNKING_STRATEGY=semantic
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
MAX_RETRIEVAL_ATTEMPTS=2
QUERY_EXPANSION_ENABLED=true

# --- Security / abuse control ---
# ADMIN_TOKEN: leave empty for local dev (DELETE /documents is then open).
# Set a long random value in a deployment to require an X-Admin-Token
# header on document deletion. Uploads and queries stay open (public
# demo) and are protected by per-IP rate limits instead.
ADMIN_TOKEN=
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
